{
  "name": "tjg-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "lint": "eslint .",
    "test:lint": "node --test tests/tooling/lint.test.mjs",
    "test": "jest",
    "audit:blog": "node scripts/audit-sanity-blog.mjs",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json",
    "test:browser": "playwright test",
    "studio": "cd sanity && sanity dev",
    "studio:validate": "cd sanity && sanity schema validate",
    "test:schemas": "tsx scripts/validate-schemas.ts"
  },
  "dependencies": {
    "@flags-sdk/vercel": "^1.4.7",
    "@lisse/react": "^0.7.2",
    "@sanity/client": "^8.5.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/webhook": "^4.0.4",
    "@thatjoshguy/oneui-icons": "^1.1.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge-config": "^1.5.1",
    "@vercel/flags-core": "^1.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "flags": "^4.3.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.63.0",
    "@sanity/schema": "^6.12.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "jest": "^30.5.1",
    "sanity": "^6.12.0",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "postcss": "^8.5.23",
    "sharp": "$sharp",
    "ws": "8.21.0",
    "@vercel/frameworks": {
      "js-yaml": "^3.15.2",
      "smol-toml": "^1.6.1"
    },
    "typeid-js": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=24 <27"
  }
}
